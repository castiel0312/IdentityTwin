  "components": {
    "schemas": {
      "EventIngestRequest": {
        "properties": {
          "event_type": {
            "$ref": "#/components/schemas/EventType",
            "description": "Standardized security or behavioral event classification"
          },
          "session_id": {
            "type": "string",
            "format": "uuid",
            "title": "Session Id",
            "description": "Authoritative session identifier"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time",
            "title": "Occurred At",
            "description": "Client event timestamp (ISO 8601 UTC)"
          },
          "device_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ],
            "title": "Device Id",
            "description": "Device fingerprint or identifier"
          },
          "ip_address": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 45
              },
              {
                "type": "null"
              }
            ],
            "title": "Ip Address",
            "description": "Client IP address (IPv4 or IPv6)"
          },
          "action": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Action",
            "description": "Discrete user action name"
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata",
            "description": "Structured, bounded event metadata (no arbitrary unbounded JSON)"
          },
          "idempotency_key": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "minLength": 8
              },
              {
                "type": "null"
              }
            ],
            "title": "Idempotency Key"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_type",
          "session_id",
          "occurred_at",
          "action"
        ],
        "title": "EventIngestRequest"
      },
      "EventIngestResponse": {
        "properties": {
          "event_id": {
            "type": "string",
