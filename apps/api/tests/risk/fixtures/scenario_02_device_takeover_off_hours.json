{
  "scenario_id": "device_takeover_off_hours",
  "title": "Device takeover during off-hours",
  "description": "An attacker takes over the account from an unseen device in the middle of the night. The first event must be flagged with a new device plus an unusual hour, and the second event from the same device must not double count because session scoped signals are latched.",
