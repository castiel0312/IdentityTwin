    "ip_address": "203.0.113.10",
    "location": "Bengaluru",
    "active_local_hour": 10
  },
  "baseline": [
    {
      "action": "payee.add",
      "event_type": "payee.added",
      "device_id": "device-alpha",
      "ip_address": "203.0.113.10",
      "location": "Bengaluru",
      "local_time": "10:00",
      "day_offset": -3,
      "recipient": "payroll@vendor.com",
      "repeat": 2,
      "repeat_spacing_minutes": 1
    },
    {
      "action": "auth.login",
      "event_type": "auth.login",
      "device_id": "device-alpha",
      "ip_address": "203.0.113.10",
      "location": "Bengaluru",
      "local_time": "10:02",
      "day_offset": -3,
      "repeat": 12,
      "repeat_spacing_minutes": 1
    }
  ],
  "attack": [
    {
      "step": 1,
      "action": "auth.login",
      "event_type": "auth.login",
      "device_id": "device-attack-02",
      "ip_address": "198.51.100.88",
      "location": "Bengaluru",
      "local_time": "03:00",
      "day_offset": 0,
      "expected": {
        "risk_score": 29,
