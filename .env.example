# Local development only. Replace credentials with secret-manager values
# before any non-local deployment.
ENVIRONMENT=development
ALLOW_DEV_AUTH=true
DEV_AUTH_TOKEN=

DATABASE_URL=sqlite:///./identitytwin_dev.db
HONEY_DB_URL=

PAYMENT_PROVIDER=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

CANARY_HMAC_SECRET=
EVIDENCE_HMAC_KEY=

# Person 6 AI Investigator: read-only, advisory, deterministic by default.
# The optional LLM narrative is disabled unless explicitly configured.
AI_INVESTIGATION_ENABLED=true
AI_LLM_ENABLED=false
AI_LLM_BASE_URL=
AI_LLM_EGRESS_HOST=
AI_LLM_API_KEY=
AI_LLM_MODEL=
AI_LLM_TIMEOUT=10.0
AI_LLM_MAX_INPUT_CHARS=12000
AI_LLM_MAX_RESPONSE_BYTES=65536
AI_INVESTIGATION_MAX_EVENTS=100

# Person 6 Intent Profiler: persistence and reads are advisory-only.
INTENT_PROFILER_ENABLED=true

OIDC_ISSUER_URL=
OIDC_JWKS_URL=
OIDC_AUDIENCE=identitytwin-api

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
