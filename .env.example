# IdentityTwin Environment Configuration Example
# Copy this file to .env for local development

# Runtime Environment (development | staging | production)
ENVIRONMENT=development

# API Settings
PROJECT_NAME="IdentityTwin Trust Gateway API"
VERSION="0.1.0"
API_V1_PREFIX="/v1"

# Development-only Authentication
# WARNING: ALLOW_DEV_AUTH must be set to false in production environments!
ALLOW_DEV_AUTH=true
DEV_AUTH_TOKEN="dev-secret-token-change-in-prod"

# Database Configuration
# Local SQLite fallback default (easy setup without Docker):
DATABASE_URL="sqlite:///./identitytwin_dev.db"
# PostgreSQL default (for Docker Compose or production):
# DATABASE_URL="postgresql://identitytwin_user:identitytwin_pass@localhost:5432/identitytwin"

# CORS Configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# Trust Gateway Thresholds (0.0 to 100.0)
RISK_THRESHOLD_RESTRICTED=50.0
RISK_THRESHOLD_ISOLATED=80.0
RISK_BASELINE_SCORE=0.0

# Payment Provider Adapter
# Options: mock, paypal_sandbox
PAYMENT_PROVIDER="mock"

# Logging
LOG_LEVEL="INFO"
LOG_FORMAT="json"
