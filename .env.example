# IdentityTwin Environment Configuration Example
# Copy this file to .env for local development

# Runtime Environment (development | staging | production)
ENVIRONMENT=development

# API Settings
PROJECT_NAME="IdentityTwin Trust Gateway API"
VERSION="0.1.0"
API_V1_PREFIX="/v1"

# Development-only Authentication
# WARNING: ALLOW_DEV_AUTH must be set to false in production environments!
ALLOW_DEV_AUTH=true
DEV_AUTH_TOKEN="dev-secret-token-change-in-prod"

# Database Configuration
# Local SQLite fallback default (easy setup without Docker):
DATABASE_URL="sqlite:///./identitytwin_dev.db"
# PostgreSQL default (for Docker Compose or production):
# DATABASE_URL="postgresql://identitytwin_user:identitytwin_pass@localhost:5432/identitytwin"

# CORS Configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# Trust Gateway Policy Thresholds (PRD: Normal 0-29, Restricted 30-59, Decoy 60-89, Isolated 90-100)
RISK_THRESHOLD_RESTRICTED=30.0
RISK_THRESHOLD_DECOY=60.0
RISK_THRESHOLD_ISOLATED=90.0
RESTRICTED_PAYOUT_LIMIT=500.0
RISK_BASELINE_SCORE=0.0

# Payment Provider Adapter
# Exhaustive: mock | paypal_sandbox. Any other value aborts startup.
# mock needs no PayPal credentials; paypal_sandbox requires the two below.
PAYMENT_PROVIDER="mock"

# PayPal Sandbox Integration (required when PAYMENT_PROVIDER="paypal_sandbox")
# Startup fails if either value is missing or blank; values are never logged.
# Create a REST app in https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID="YOUR_PAYPAL_SANDBOX_CLIENT_ID"
PAYPAL_CLIENT_SECRET="YOUR_PAYPAL_SANDBOX_CLIENT_SECRET"
# Webhook id of the PayPal webhook that delivers to this deployment.
# Inbound webhooks are verified with PayPal's /v1/notifications/verify-webhook-signature
# endpoint using this id. While it is empty every delivery is rejected (fail closed).
# Find it in the PayPal Developer Dashboard -> your app -> Webhooks, or with
# GET $PAYPAL_BASE_URL/v1/notifications/webhooks. See docs/local-development.md section 7.
PAYPAL_WEBHOOK_ID="YOUR_PAYPAL_SANDBOX_WEBHOOK_ID"
# Sandbox-only: this exact origin is enforced at startup and in the adapter.
PAYPAL_BASE_URL="https://api-m.sandbox.paypal.com"
PAYPAL_REQUEST_TIMEOUT=10.0

# Logging
LOG_LEVEL="INFO"
LOG_FORMAT="json"
